---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Engineer's Atlas V3 | Ali"
  description="An engineering portfolio covering systems, simulation, robotics, and applied AI."
>
  <section class="foundation" aria-labelledby="foundation-title">
    <p class="eyebrow">03 / Development foundation</p>
    <h1 id="foundation-title">The Engineer's <em>Atlas</em></h1>
    <p class="lede">
      The static site foundation is ready. The approved editorial homepage and
      interactive engineering atlas will be implemented in the next milestones.
    </p>
    <dl class="status-list" aria-label="Foundation status">
      <div>
        <dt>Rendering</dt>
        <dd>Static HTML</dd>
      </div>
      <div>
        <dt>Content</dt>
        <dd>Typed Markdown</dd>
      </div>
      <div>
        <dt>Client runtime</dt>
        <dd>None yet</dd>
      </div>
    </dl>
  </section>
</BaseLayout>
