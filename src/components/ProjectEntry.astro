---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AtlasIndex from './AtlasIndex.astro';

interface Props {
  id: string;
  title: string;
  category: string;
  summary: string;
  href: string;
  plate: { index: string; label: string; figureLabel?: string };
  image?: {
    src: ImageMetadata;
    alt: string;
    caption: string;
    source?: string;
  };
  layout?: 'featured' | 'reversed' | 'architecture';
  note?: string;
}

const { id, title, category, summary, href, plate, image, layout, note } = Astro.props;
const hasMedia = Boolean(image) || Astro.slots.has('media');
---

<article id={id} tabindex="-1" aria-labelledby={`${id}-title`} class:list={['project', layout, { illustrated: hasMedia }]}>
  <div class="project-copy">
    <AtlasIndex index={plate.index} label={plate.label} />
    <p class="eyebrow">{category}</p>
    <h3 id={`${id}-title`}>{title}</h3>
    <p>{summary}</p>
    {note && <p class="review">{note}</p>}
    <a href={href} aria-label={`View ${title} on GitHub`}>View repository <span aria-hidden="true">↗</span></a>
    <slot name="flow" />
  </div>
  {hasMedia && (
    <div class="media">
      {image && (
        <figure class="plate">
          <div class="plate-head">
            <span>{plate.figureLabel}</span>
            <span aria-hidden="true" class="frame-mark">+</span>
          </div>
          <div class="plate-image">
            <Image src={image.src} width={Math.min(image.src.width, 1120)} alt={image.alt} widths={[360, 600, Math.min(image.src.width, 1120)]} sizes="(max-width: 768px) 92vw, 53vw" />
          </div>
          <figcaption>
            {image.caption}{image.source && <> · <a href={image.source}>Original figure</a></>}
            <slot name="credit" />
          </figcaption>
        </figure>
      )}
      <slot name="media" />
    </div>
  )}
</article>

<style>
  .project { padding-block: clamp(0.875rem, 1.65vw, 1.45rem); border-top: 1px solid var(--color-rule); scroll-margin-block: 1rem; }
  .project:target { border-top-color: var(--color-accent); }
  .illustrated { display: grid; grid-template-columns: minmax(0, 4.5fr) minmax(0, 5.5fr); gap: clamp(0.7rem, 2.4vw, 2.1rem); align-items: center; }
  .project-copy { display: grid; gap: 0.45rem; justify-items: start; min-width: 0; }
  .project-copy p.eyebrow { margin-block-start: 0.4rem; }
  h3 { max-width: 22ch; font-size: clamp(1.45rem, 2.6vw, 2.4rem); line-height: 1.08; }
  .featured h3 { font-size: var(--step-2); }
  p { max-width: 46ch; }
  .review { font-size: 0.875rem; border-inline-start: 1px solid var(--color-accent); padding-inline-start: 0.75rem; }
  a { display: inline-flex; align-items: center; min-height: 2.75rem; gap: 0.4em; }
  .media { min-width: 0; }
  .media img { width: 100%; }
  .media figure { margin-inline: auto; max-width: 38rem; }
  .featured .media figure { max-width: 41rem; }
  .reversed .media figure { max-width: 32rem; }
  .plate { background: var(--color-sheet); border-block: 1px solid var(--color-rule); }
  .plate-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0.65rem;
    font: 500 0.6875rem/1.4 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.055em;
  }
  .frame-mark { color: var(--color-accent); font-size: 1rem; line-height: 1; }
  .plate-image { border-block: 1px solid var(--color-rule); }
  .featured .plate-head { background: var(--color-ink); color: var(--color-canvas); }
  .featured .frame-mark { color: var(--color-canvas); }
  .reversed .plate-image {
    padding: clamp(0.35rem, 0.8vw, 0.75rem);
    background:
      linear-gradient(var(--color-rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-rule) 1px, transparent 1px);
    background-size: 0.65rem 0.65rem;
  }
  figcaption { margin-top: 0.55rem; font: 0.75rem/1.45 var(--font-mono); }
  .plate figcaption { margin: 0; padding: 0.5rem 0.65rem; }
  figcaption a { display: inline-block; min-height: auto; }
  @media (width > 48rem) {
    .reversed { grid-template-columns: minmax(0, 5.5fr) minmax(0, 4.5fr); }
    .reversed .media { grid-area: 1 / 1; }
    .reversed .project-copy { grid-area: 1 / 2; }
    .architecture { grid-template-columns: minmax(0, 3.5fr) minmax(0, 6.5fr); }
  }
  @media (max-width: 48rem) { .illustrated { grid-template-columns: minmax(0, 1fr); } }
</style>
