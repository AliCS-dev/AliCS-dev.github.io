---
import { atlasDisciplines, atlasProjects, type AtlasProjectId } from '../data/atlas';

const projects = ['urban-uav', 'mosaic-rag', 'banking', 'traffic-monitoring'] as const satisfies readonly AtlasProjectId[];
const rows = [62, 117, 172, 227];
---

<svg class="atlas-connections" viewBox="0 0 540 262" role="group" aria-label="Connections between engineering disciplines and projects">
  <g aria-hidden="true">
    <text class="label" x="24" y="23">DISCIPLINES</text>
    <text class="label" x="346" y="23">PROJECTS</text>
    {atlasDisciplines.map(({ id, projects: connected }, index) => connected.map(project => {
      const y = rows[index];
      const endpoint = rows[projects.indexOf(project)];
      return <path class="connection" data-atlas-edge data-discipline={id} data-project={project}
        d={`M194 ${y} C250 ${y} 290 ${endpoint} 346 ${endpoint}`} />;
    }))}
  </g>
  {atlasDisciplines.map(({ id, label }, index) => (
    <a href={`#atlas-${id}`} data-atlas-select={id} aria-label={label}>
      <rect class="node" x="24" y={rows[index] - 20} width="170" height="40" />
      <text x="36" y={rows[index]} dominant-baseline="central" aria-hidden="true">{label}</text>
      <rect class="port" x="190.5" y={rows[index] - 3.5} width="7" height="7" aria-hidden="true" />
    </a>
  ))}
  {projects.map((id, index) => (
    <a href={`#atlas-project-${id}`} data-atlas-project={id} aria-label={atlasProjects[id].label}>
      <rect class="node" x="346" y={rows[index] - 20} width="170" height="40" />
      <text x="358" y={rows[index]} dominant-baseline="central" aria-hidden="true">{atlasProjects[id].label}</text>
      <circle class="port" cx="346" cy={rows[index]} r="4" aria-hidden="true" />
    </a>
  ))}
</svg>

<style>
  .atlas-connections { width: 100%; max-width: 48rem; min-width: 0; display: block; }
  text { fill: var(--color-ink); font: 15px var(--font-mono); }
  .label { fill: var(--color-accent); font-size: 12px; letter-spacing: .075em; }
  .connection { fill: none; stroke: #766e66; stroke-width: 1.4; stroke-dasharray: 4 3; }
  .connection[data-dim] { stroke: #847b72; stroke-width: 1; }
  .connection[data-active] { stroke: var(--color-accent); stroke-width: 2.7; stroke-dasharray: none; }
  .node { fill: var(--color-canvas); stroke: #766e66; }
  .port { fill: #766e66; stroke: var(--color-canvas); }
  a[data-active] .node { stroke: var(--color-accent); stroke-width: 2; }
  a[data-active] :is(text, .port) { fill: var(--color-accent); }
  a[aria-current="true"] .node { fill: #efe1d9; }
  a:focus-visible { outline: 0; }
  a:focus-visible .node { stroke: var(--color-ink); stroke-width: 3; stroke-dasharray: 5 2; }
</style>
