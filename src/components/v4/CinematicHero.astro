---
import { getImage, Image } from 'astro:assets';
import art from '../../assets/cinematic-exhibition.png';
import traffic from '../../assets/traffic-analysis.png';
import banking from '../../assets/banking-schema.png';
import MosaicArchitecture from '../MosaicArchitecture.astro';
import { caseStudies, caseHref } from '../../data/cases';
import MediaCredit from './MediaCredit.astro';

const [trafficTexture, bankingTexture] = await Promise.all([
  getImage({ src: traffic, width: 1024, format: 'webp' }),
  getImage({ src: banking, width: 960, format: 'webp' }),
]);
---

<section class="cinematic" aria-labelledby="home-title" data-cinematic data-mode="still" data-focus="overview"
  data-traffic={trafficTexture.src} data-banking={bankingTexture.src}>
  <div class="shell hero-layout">
    <div class="hero-copy">
      <p class="v4-kicker">Engineering portfolio</p>
      <h1 id="home-title">The Engineer’s<br />Atlas</h1>
      <p class="hero-lede">Multidisciplinary engineering<br />through real systems</p>
      <p class="hero-intro">I’m Ali, a computer science student working across simulation, computer vision, full stack systems and applied AI.</p>
      <a class="v4-button" href="#work">Explore projects <span aria-hidden="true">→</span></a>
    </div>
    <div class="exhibition">
      <div class="stage">
        <div class="scene-frame">
          <figure class="opening">
            <Image src={art} width={1536} widths={[480, 768, 1024, 1536]} sizes="(max-width: 760px) 100vw, 69vw" format="webp" quality={80}
              loading="eager" fetchpriority="high"
              alt="Conceptual architectural exhibition with a drone above a miniature city, a suspended display, a laptop and layered documents." />
          </figure>
          <div class="live" data-scene hidden aria-hidden="true"></div>
        </div>
        <nav class="callouts" aria-label="Projects in the exhibition">
          {caseStudies.map(project => (
            <a class={`callout callout-${project.id}`} data-exhibit-project={project.id} href={caseHref(project.id)}>
              <span class="marker" aria-hidden="true"></span>
              <span><small>{project.number} / {project.domain}</small><strong>{project.short}</strong></span>
            </a>
          ))}
        </nav>
      </div>
      <div class="stage-caption">
        <span>Conceptual exhibition · Original artifacts in each project</span>
        <button type="button" data-live-toggle hidden>Enable live 3D <span aria-hidden="true">↗</span></button>
      </div>
    </div>
    <div class="inspection" data-inspection hidden>
      <div class="inspection-controls"><button type="button" data-overview>← Scene overview</button></div>
      {caseStudies.map(project => (
        <article data-exhibit-detail={project.id} hidden>
          <div class="artifact">
            {project.image && project.alt
              ? <Image src={project.image} alt={project.alt} widths={[400, 640, Math.min(1100, project.image.width)].filter(width => width <= project.image!.width)}
                  width={Math.min(1100, project.image.width)} sizes="(max-width: 760px) 92vw, 42vw" loading="lazy" />
              : <MosaicArchitecture />}
          </div>
          <div class="inspection-copy">
            <p class="v4-kicker">{project.number} / {project.domain}</p>
            <h2>{project.title}</h2>
            <p>{project.summary}</p>
            <p class="artifact-label">{project.caption}</p>
            {project.id === 'traffic-monitoring' && <MediaCredit />}
            <a class="v4-button" href={caseHref(project.id)}>Read case study <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
    <p role="status" class="visually-hidden" data-exhibit-status></p>
  </div>
</section>

<script>
  import { initExhibition } from '../../scripts/exhibition';
  document.querySelectorAll<HTMLElement>('[data-cinematic]').forEach(initExhibition);
</script>

<style>
  .cinematic { position: relative; background: var(--color-sheet); border-bottom: 1px solid var(--color-rule); }
  .hero-layout { display: grid; grid-template-columns: minmax(15rem, 0.57fr) minmax(0, 1.43fr); align-items: center; position: relative; }
  .hero-copy { position: relative; z-index: 1; padding: clamp(2rem, 5vw, 5rem) 0; }
  h1 { margin-block: .85rem .7rem; font: 400 clamp(3rem, 5.15vw, 6.4rem)/.85 var(--font-editorial); letter-spacing: -.038em; }
  .hero-lede { font: italic clamp(1.45rem, 2.05vw, 2.4rem)/1.04 var(--font-editorial); }
  .hero-intro { max-width: 34ch; margin-block: .95rem 1.25rem; font-size: .95rem; }
  .exhibition { min-width: 0; }
  .stage { position: relative; isolation: isolate; }
  .scene-frame { position: relative; }
  .opening { min-height: 0; }
  .opening img { width: 100%; height: auto; }
  @media (min-width: 931px) {
    .opening img { mask-image: linear-gradient(to right, transparent, #000 10%); }
  }
  .live { position: absolute; inset: 0; }
  .cinematic[data-mode="loading"] .live { visibility: hidden; }
  .cinematic[data-mode="live"] .opening { visibility: hidden; }
  .stage-caption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; min-height: 2.5rem; gap: 0 .75rem; font: .69rem/1.4 var(--font-mono); padding: .3rem .55rem; border-top: 2px solid var(--color-accent); }
  button { background: none; color: var(--color-accent); border: 0; cursor: pointer; text-decoration: underline; min-height: 2.75rem; font: 500 .74rem/1.35 var(--font-mono); }
  .callouts { position: absolute; inset: 0; pointer-events: none; }
  .callout { position: absolute; display: flex; align-items: center; gap: .5rem; padding: .45rem .55rem; min-height: 2.75rem; text-decoration: none; background: var(--color-canvas); pointer-events: auto; }
  .callout small, .callout strong { display: block; }
  .callout small { color: var(--color-accent); font: .63rem/1.35 var(--font-mono); text-transform: uppercase; }
  .callout strong { font: 1.2rem/1 var(--font-editorial); }
  .marker { flex: none; width: .45rem; height: .45rem; background: var(--color-accent); rotate: 45deg; }
  .callout:hover, .callout[aria-current] { box-shadow: inset 0 -2px var(--color-accent); }
  .callout[aria-current] { color: var(--color-canvas); background: var(--color-accent); }
  .callout[aria-current] :is(small, .marker) { color: inherit; }
  .callout[aria-current] .marker { background: currentColor; }
  .callout-urban-uav { top: 16%; left: 22%; }
  .callout-traffic-monitoring { top: 37%; right: 4%; }
  .callout-banking { bottom: 12%; left: 6%; }
  .callout-mosaic-rag { bottom: 8%; right: 4%; }
  @media (min-width: 931px) {
    .cinematic:not([data-mode="live"]) .callout::after {
      content: '';
      position: absolute;
      inline-size: 2.4rem;
      block-size: 1px;
      background: #e9b1a3;
      pointer-events: none;
    }
    .cinematic:not([data-mode="live"]) .callout-urban-uav::after { inset: 100% 5% auto auto; rotate: 32deg; transform-origin: right; }
    .cinematic:not([data-mode="live"]) .callout-traffic-monitoring::after { inset: auto auto 100% 40%; rotate: -67deg; transform-origin: left; }
    .cinematic:not([data-mode="live"]) .callout-banking::after { inset: auto auto 100% 60%; rotate: -40deg; transform-origin: left; }
    .cinematic:not([data-mode="live"]) .callout-mosaic-rag::after { inset: auto auto 100% 18%; rotate: -54deg; transform-origin: left; }
  }
  .cinematic[data-mode="live"] .callouts { position: static; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .cinematic[data-mode="live"] .callout { position: static; }
  .cinematic[data-mode="live"] .callout[aria-current]:focus-visible { outline-offset: -4px; outline-color: var(--color-canvas); }
  .inspection { grid-column: 1 / -1; padding-block: .5rem 1rem; border-top: 1px solid var(--color-rule); }
  .inspection article { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center; gap: clamp(1rem, 3vw, 3rem); }
  .inspection article[hidden] { display: none; }
  .artifact img { width: 100%; max-height: 23rem; object-fit: contain; background: #252321; }
  .inspection h2 { font: 400 clamp(1.9rem, 3.1vw, 3.4rem)/.95 var(--font-editorial); margin-block: .45rem; }
  .inspection-copy p { margin-block-end: .55rem; }
  .artifact-label { font: .76rem/1.4 var(--font-mono); color: var(--color-accent); }
  @media (prefers-reduced-motion: no-preference) {
    .inspection article:not([hidden]) { animation: reveal .2s ease-out; }
    @keyframes reveal { from { opacity: .72; } to { opacity: 1; } }
  }
  @media (max-width: 930px) {
    .callouts { position: static; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--color-rule); }
    .callout { position: static; border-bottom: 1px solid var(--color-rule); }
    .cinematic[data-mode="live"] .callouts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .hero-layout, .inspection article { grid-template-columns: minmax(0, 1fr); }
    .hero-copy { padding: 1.4rem 0 1rem; }
    h1 { font-size: clamp(2.65rem, 11vw, 4.8rem); margin-block: .6rem; }
    .hero-intro { margin-block: .55rem .8rem; }
    .opening img { aspect-ratio: 1.34; object-fit: cover; object-position: 53% center; }
    .callouts { grid-template-columns: minmax(0, 1fr); }
    .callout { padding-inline: .7rem; }
    .callout > span:last-child { display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .55rem; }
    .cinematic[data-focus]:not([data-focus="overview"]) .opening { display: none; }
    .inspection .artifact { order: 0; }
  }
</style>
