---
const path = Astro.url.pathname;
const links = [
  ['/', 'Home'], ['/projects/', 'Work'], ['/research/', 'Research'], ['/about/', 'About'], ['/#contact', 'Contact'],
];
---

<header class="v4-nav">
  <div class="shell mast">
    <a class="identity" href="/" aria-label="The Engineer’s Atlas home"><span aria-hidden="true">A<b>.</b></span> <small>The Engineer’s Atlas</small></a>
    <nav aria-label="Primary">
      {links.map(([href, label], index) => (
        <a href={href} aria-current={href === path || (href === '/projects/' && path.startsWith(href)) ? 'page' : undefined}>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .v4-nav { background: var(--color-accent); color: var(--color-canvas); border-bottom: 1px solid #88382e; }
  .mast, nav, .identity { display: flex; flex-wrap: wrap; align-items: center; }
  .mast { justify-content: space-between; min-height: 4.25rem; gap: 0 1.4rem; }
  .identity { min-height: 2.75rem; gap: .85rem; text-decoration: none; }
  .identity > span { font: 2.65rem/.9 var(--font-editorial); }
  .identity b { color: var(--color-canvas); }
  small { border-left: 1px solid #f3f1ea80; padding-inline-start: .85rem; font: .75rem/1.4 var(--font-mono); letter-spacing: .09em; text-transform: uppercase; }
  nav { gap: 0 clamp(.55rem, 2.2vw, 2rem); }
  nav a { display: inline-flex; align-items: center; gap: .45rem; min-height: 2.75rem; font: .875rem/1.4 var(--font-mono); text-decoration: none; }
  nav a span { font-size: .8em; }
  nav a:hover, nav a[aria-current] { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .42em; }
  nav a[aria-current] { font-weight: 500; }
  a:focus-visible { outline: 2px solid var(--color-canvas); outline-offset: .2rem; }
  @media (min-width: 64rem) {
    .mast { display: grid; grid-template-columns: var(--v4-columns); column-gap: var(--v4-column-gap); }
    .identity { justify-self: start; }
    nav { justify-self: center; }
  }
  @media (max-width: 45rem) {
    .mast { padding-block-start: .35rem; }
    nav { flex-basis: 100%; justify-content: space-between; column-gap: .35rem; }
    nav a { min-inline-size: 2.75rem; justify-content: center; font-size: .8125rem; }
    nav a span { display: none; }
  }
</style>
