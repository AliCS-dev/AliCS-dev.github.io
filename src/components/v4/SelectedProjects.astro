---
import { Image } from 'astro:assets';
import { caseStudies, caseHref } from '../../data/cases';
import MediaCredit from './MediaCredit.astro';
interface Props { heading?: boolean }
const { heading = true } = Astro.props;
const ProjectHeading = heading ? 'h3' : 'h2';
const mosaicFlow = [
  { service: 'API', action: 'Receives the query' },
  { service: 'Retriever', action: 'Returns documents to the API' },
  { service: 'API', action: 'Sends the query and documents' },
  { service: 'Generator', action: 'Returns the answer to the API' },
];
---

<section id="work" class="shell selected" aria-labelledby="selected-title">
  <header>
    <div>
      <p class="v4-kicker">Featured work</p>
      {heading ? <h2 id="selected-title" class="v4-title">Projects</h2> : <h1 id="selected-title" class="v4-title">Engineering projects</h1>}
    </div>
    <p>Real systems across simulation, computer vision, full stack development and applied AI.</p>
    {heading && <a class="view-all" href="/projects/">View all projects →</a>}
  </header>
  <div class="plates">
    {caseStudies.map(project => {
      const featured = project.id === 'urban-uav';
      const architecture = project.id === 'mosaic-rag';
      const image = project.image;
      return (
        <article class:list={['plate', project.id, { featured, architecture }]} aria-labelledby={`work-${project.id}`}>
          <figure class="plate-figure">
            <div class="media">
              {image && project.alt && (
                <Image src={image} alt={project.alt}
                  width={Math.min(image.width, 1120)}
                  widths={[420, 760, 1120, 1440].filter(width => width < image.width).concat(image.width)}
                  sizes={featured ? '(max-width: 740px) 92vw, (max-width: 1739px) 56vw, 950px' : '(max-width: 740px) 92vw, (max-width: 1739px) 45vw, 780px'} />
              )}
              {architecture && (
                <div class="flow">
                  <p class="v4-kicker">Request flow</p>
                  <ol role="list">
                    {mosaicFlow.map(({ service, action }, index) => (
                      <li>
                        <span class="flow-step" aria-hidden="true">0{index + 1}</span>
                        <strong>{service}</strong>
                        <span>{action}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              )}
            </div>
            <figcaption>
              <span>{project.caption}</span>
              {image && <a href={image.src}>Full-size image<span class="visually-hidden"> for {project.title}</span></a>}
            </figcaption>
          </figure>
          <div class="text">
            <p class="v4-kicker">{project.number} / {project.domain}</p>
            <ProjectHeading id={`work-${project.id}`} class="project-heading">{project.title}</ProjectHeading>
            <p>{project.summary}</p>
            <a class="case-link" href={caseHref(project.id)}>Case study<span class="visually-hidden"> for {project.title}</span> <span aria-hidden="true">→</span></a>
          </div>
        </article>
      );
    })}
  </div>
  <div class="credited-image"><MediaCredit /></div>
</section>

<style>
  .selected { padding-block: clamp(1.8rem, 4vw, 4rem); }
  header { display: flex; align-items: end; flex-wrap: wrap; gap: .8rem 2.5rem; margin-bottom: 1.4rem; }
  header .v4-title { margin-block-end: 0; }
  header > p { max-width: 34ch; font-size: var(--v4-body); }
  .view-all { margin-inline-start: auto; color: var(--color-accent); font: .8rem/1.4 var(--font-mono); }
  .plates { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.25rem, 2.4vw, 2.4rem); }
  .plate { min-width: 0; border-block-start: 1px solid var(--color-rule); padding-block-start: 1rem; }
  .featured, .architecture { display: grid; grid-column: 1 / -1; align-items: center; gap: 1.1rem clamp(1.5rem, 4vw, 4rem); }
  .featured { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); border-block-start: 2px solid var(--color-accent); }
  .architecture { grid-template-columns: minmax(0, 1fr) minmax(0, 1.85fr); }
  .architecture .plate-figure { grid-column: 2; grid-row: 1; }
  .architecture .text { grid-column: 1; grid-row: 1; }
  .plate-figure { border: 1px solid var(--color-rule); background: var(--color-sheet); }
  .media { display: grid; place-items: center; }
  .media img { width: 100%; aspect-ratio: 1.44; object-fit: contain; }
  .featured .media { background: #212121; }
  .featured img { aspect-ratio: 1.5; object-fit: cover; object-position: center bottom; }
  .traffic-monitoring .media { background: #f3f5f6; }
  .banking .media { background: #404047; }
  figcaption { display: flex; justify-content: space-between; flex-wrap: wrap; align-items: center; gap: .15rem .85rem; min-block-size: 3.25rem; padding: .65rem .85rem; border-block-start: 1px solid var(--color-rule); font: .75rem/1.4 var(--font-mono); }
  figcaption a { color: var(--color-accent); }
  .text { padding-block-start: .9rem; }
  .featured .text, .architecture .text { padding-block-start: 0; }
  .project-heading { font: 400 clamp(1.375rem, 1.18rem + .6vw, 1.75rem)/1.12 var(--font-editorial); margin-block: .35rem .55rem; }
  .featured .project-heading { font-size: var(--v4-project); }
  .credited-image { border-block-start: 1px solid var(--color-rule); margin-block-start: 1.5rem; padding-block-start: .75rem; }
  .text p:not(.v4-kicker) { max-width: 49ch; font-size: var(--v4-body); line-height: 1.55; }
  .case-link { display: inline-flex; align-items: center; gap: .5rem; color: var(--color-accent); font: .8rem/1.4 var(--font-mono); min-height: 2.75rem; }
  figcaption a:hover, .case-link:hover, .view-all:hover { text-decoration-thickness: 2px; }
  .flow { width: 100%; padding: clamp(1rem, 2.8vw, 2rem); }
  .flow ol { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; padding: 0; margin: .85rem 0 0; list-style: none; }
  .flow li { position: relative; display: grid; align-content: start; gap: .35rem; border-block-start: 2px solid var(--color-accent); padding: .65rem; background: var(--color-canvas); }
  .flow li + li::before {
    content: '';
    position: absolute;
    inset: 1rem auto auto -.65rem;
    width: .35rem;
    height: .35rem;
    border-block-start: 1px solid var(--color-accent);
    border-inline-end: 1px solid var(--color-accent);
    transform: rotate(45deg);
  }
  .flow li strong { font-size: 1rem; }
  .flow li span { font-size: .875rem; line-height: 1.4; }
  .flow li .flow-step { color: var(--color-accent); font: .75rem/1.4 var(--font-mono); }
  @media (max-width: 1050px) {
    .flow ol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .flow li:nth-child(3)::before { display: none; }
  }
  @media (740px < width <= 1250px) {
    :is(.traffic-monitoring, .banking) figcaption { min-block-size: 4.85rem; }
  }
  @media (max-width: 740px) {
    header { gap: .55rem 1rem; }
    .plates, .featured, .architecture { grid-template-columns: minmax(0, 1fr); }
    .architecture .plate-figure, .architecture .text { grid-area: auto; }
    .view-all { margin-inline-start: 0; }
  }
</style>
