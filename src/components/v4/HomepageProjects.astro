---
import { caseHref, caseStudies } from '../../data/cases';
import type { AtlasProjectId } from '../../data/atlas';

const thesis = 'traffic-monitoring';
const projects = [...caseStudies].sort((a, b) => Number(b.id === thesis) - Number(a.id === thesis));
const technologies = {
  'traffic-monitoring': ['FastAPI', 'OpenCV', 'PostgreSQL'],
  'urban-uav': ['MATLAB', 'Simulink', 'RRT*'],
  banking: ['React', 'NestJS', 'PostgreSQL'],
  'mosaic-rag': ['FastAPI', 'Docker Compose', 'RAG'],
} satisfies Record<AtlasProjectId, readonly string[]>;
---

<section id="work" class="shell projects" aria-labelledby="projects-title">
  <header class="section-header">
    <h2 id="projects-title" class="v4-title">Projects</h2>
    <a class="all-projects" href="/projects/">View all projects <span aria-hidden="true">→</span></a>
  </header>
  <div class="project-grid">
    {projects.map(project => {
      const featured = project.id === thesis;
      return (
        <article class:list={['project', { featured }]} aria-labelledby={`work-${project.id}`}>
          <div class="project-copy">
            <p class="project-index">
              <span class="number">{project.number}</span>
              <span>{featured ? 'BSc Thesis' : project.domain}</span>
            </p>
            <h3 id={`work-${project.id}`}>{project.title}</h3>
            <p class="summary">{project.summary}</p>
          </div>
          <div class="project-details">
            {featured && (
              <div class="thesis-context">
                <p class="v4-kicker">Computer vision</p>
                <p>The detector predictions are experimental. Dense-crowd counting is unsupported.</p>
              </div>
            )}
            <ul class="technologies" role="list" aria-label="Technologies">
              {technologies[project.id].map(technology => <li>{technology}</li>)}
            </ul>
            <a class="case-link" href={caseHref(project.id)}>
              <span class="link-label">Read case study<span class="visually-hidden"> for {project.title}</span></span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .projects { padding-block: clamp(2rem, 4vw, 4rem); }
  .section-header { display: flex; align-items: end; justify-content: space-between; flex-wrap: wrap; gap: .3rem 1.5rem; margin-block-end: 1.05rem; }
  .section-header h2 { margin: 0; color: var(--color-accent); }
  .all-projects, .case-link {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    min-height: 2.75rem;
    color: var(--color-accent);
    font: 500 .8125rem/1.4 var(--font-mono);
  }
  .project-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(.9rem, 1.65vw, 1.6rem); }
  .project {
    display: flex;
    flex-direction: column;
    gap: clamp(1.1rem, 2vw, 1.7rem);
    padding: clamp(1rem, 2.15vw, 2rem);
    border: 1px solid var(--color-accent);
  }
  .project:hover, .project:focus-within { border-color: color-mix(in srgb, var(--color-accent) 75%, var(--color-ink)); }
  .featured {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.25rem, 4.5vw, 4.5rem);
    padding: clamp(1.25rem, 3.5vw, 3.5rem);
    border-width: 2px;
    background: color-mix(in srgb, var(--color-canvas) 68%, var(--color-sheet));
  }
  .project-index {
    display: flex;
    align-items: center;
    gap: .65rem;
    color: var(--color-accent);
    font: 500 .75rem/1.4 var(--font-mono);
    letter-spacing: .055em;
    text-transform: uppercase;
  }
  .number { padding-inline-end: .65rem; border-inline-end: 1px solid var(--color-accent); }
  .featured .project-index { gap: .75rem; font-size: .875rem; }
  .featured .number { border: 0; padding: .3rem .55rem; background: var(--color-accent); color: var(--color-canvas); }
  h3 {
    margin-block: .8rem .55rem;
    font: 400 clamp(1.625rem, 1.35rem + .65vw, 2.125rem)/1.07 var(--font-editorial);
    letter-spacing: -.015em;
    text-wrap: balance;
  }
  .featured h3 {
    max-inline-size: 20ch;
    margin-block: .85rem .75rem;
    font-size: clamp(2.35rem, 1.65rem + 2.4vw, 4rem);
  }
  .summary { max-inline-size: 50ch; font-size: var(--v4-body); line-height: 1.55; text-wrap: pretty; }
  .project-details { display: grid; gap: .55rem; margin-block-start: auto; }
  .featured .project-details { gap: .8rem; margin: 0; padding-inline-start: clamp(1rem, 2vw, 2rem); border-inline-start: 1px solid var(--color-accent); }
  .thesis-context { display: grid; gap: .35rem; max-inline-size: 37ch; }
  .thesis-context p:last-child { font-size: var(--v4-body); line-height: 1.5; }
  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem .55rem;
    padding: 0;
    margin: 0;
    list-style: none;
    font: .75rem/1.35 var(--font-mono);
  }
  .technologies li { padding: .25rem .4rem; border: 1px solid var(--color-rule); }
  .case-link { display: flex; justify-content: space-between; border-block-start: 1px solid var(--color-rule); text-decoration: none; }
  .link-label { text-decoration: underline; }
  .case-link:hover .link-label, .all-projects:hover { text-decoration-thickness: 2px; }
  .arrow { padding-inline: .25rem; }
  @media (prefers-reduced-motion: no-preference) {
    .arrow { transition: transform var(--motion-fast) ease; }
    .case-link:is(:hover, :focus-visible) .arrow { transform: translateX(.2rem); }
  }
  @media (max-width: 52rem) {
    .project-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 38rem) {
    .featured { grid-template-columns: minmax(0, 1fr); }
    .featured .project-details { padding: 1rem 0 0; border-inline-start: 0; border-block-start: 1px solid var(--color-accent); }
  }
</style>
