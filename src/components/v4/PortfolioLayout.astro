---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from './Navigation.astro';
import '../../styles/v4.css';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
---

<BaseLayout {title} {description}>
  <Navigation slot="header" />
  <slot />
  <footer id="contact" slot="footer">
    <div class="shell footer-row">
      <div>
        <h2>Contact</h2>
        <p>Get in touch about projects or collaborations.</p>
      </div>
      <div class="footer-links">
        <ul aria-label="Professional links">
          <li><a href="mailto:muhammadalikhanhitec@gmail.com">Email</a></li>
          <li><a href="https://github.com/AliCS-dev">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/muhammed-ali-khan-97708b299">LinkedIn</a></li>
          <li><a href="https://github.com/AppliedSystems-Lab">ASL on GitHub</a></li>
        </ul>
        <small>© 2026 Ali</small>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  footer { border-top: 1px solid var(--color-rule); background: var(--color-accent); color: var(--color-canvas); }
  .footer-row { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: .75rem 2rem; padding-block: clamp(1.5rem, 3vw, 2.5rem); }
  h2 { font: 400 var(--v4-section)/1.05 var(--font-editorial); margin-block-end: .35rem; }
  p { font-size: var(--v4-body); }
  .footer-links { display: grid; justify-items: end; gap: .25rem; }
  ul { display: flex; flex-wrap: wrap; gap: 0 1rem; list-style: none; margin: 0; padding: 0; }
  a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  a:hover { text-decoration-thickness: 2px; }
  a:focus-visible { outline-color: var(--color-canvas); }
  footer ::selection { background: var(--color-canvas); color: var(--color-accent); }
  small { font: .75rem/1.5 var(--font-mono); }
  @media (max-width: 46rem) { .footer-links { justify-items: start; } }
</style>
