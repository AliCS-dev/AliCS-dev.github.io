---
interface Props {
  label: string;
  steps: readonly { title: string; detail: string }[];
  caption?: string;
  source?: string;
  expanded?: boolean;
}

const { label, steps, caption, source, expanded } = Astro.props;
---

<figure class:list={['engineering-flow', { expanded }]} aria-label={label}>
  <figcaption>
    <span class="eyebrow">{label}</span>
    {caption && <p>{caption}</p>}
    {source && <a href={source}>View source <span aria-hidden="true">↗</span></a>}
  </figcaption>
  <ol>
    {steps.map(({ title, detail }, index) => (
      <li>
        {index > 0 && (
          <svg viewBox="0 0 16 12" width="16" height="12" aria-hidden="true">
            <path d="M1 6h13m-5-4 5 4-5 4" fill="none" stroke="currentColor" stroke-width="1.25" />
          </svg>
        )}
        <strong>{title}</strong>
        <span>{detail}</span>
      </li>
    ))}
  </ol>
</figure>

<style>
  .engineering-flow {
    width: 100%;
    border-block-start: 1px solid var(--color-rule);
    padding-block-start: 0.65rem;
  }
  figcaption { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.8rem; }
  figcaption p { flex: 1 1 15rem; font-size: 0.875rem; }
  figcaption a { font-size: 0.8125rem; }
  ol {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 1.25rem;
    padding: 0;
    margin: 0.65rem 0 0;
    list-style: none;
  }
  li {
    display: grid;
    align-content: start;
    gap: 0.18rem;
    position: relative;
    border-block-start: 1px solid var(--color-rule);
    padding-block-start: 0.45rem;
    overflow-wrap: anywhere;
  }
  li strong { font-size: 0.875rem; line-height: 1.25; }
  li span { font: 0.75rem/1.4 var(--font-mono); }
  svg { position: absolute; inset-inline-start: -1.15rem; top: 0.55rem; color: var(--color-accent); }
  .expanded {
    padding: 1rem;
    border-block: 1px solid var(--color-rule);
    background: var(--color-sheet);
  }
  .expanded ol { margin-block-start: 0.9rem; gap: 1.6rem; }
  .expanded li {
    padding: 0.6rem;
    border: 1px solid var(--color-rule);
    border-block-start: 2px solid var(--color-accent);
    background: var(--color-canvas);
  }
  .expanded svg { inset-inline-start: -1.4rem; top: 0.85rem; }
  .expanded li strong { font-size: 1rem; }
  @media (max-width: 35rem) {
    ol { grid-auto-flow: row; gap: 0.42rem; margin-inline-start: 1.2rem; }
    li { grid-template-columns: minmax(6.25rem, 0.9fr) minmax(0, 1fr); gap: 0.3rem 0.6rem; align-items: baseline; }
    svg { transform: rotate(90deg); }
    .expanded { padding-inline: 0.6rem; }
    .expanded ol { gap: 0.55rem; }
  }
</style>
